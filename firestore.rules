rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products Collections (both root and isolated onlyluxe namespace)
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /onlyluxe_products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Categories Collections
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /onlyluxe_categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Settings Collections
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /onlyluxe_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders Collections (public customer order creation with validation, admin full access)
    match /orders/{orderId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.phone is string 
                    && request.resource.data.totalAMD is number
                    && request.resource.data.items is list;
    }
    match /onlyluxe_orders/{orderId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.phone is string 
                    && request.resource.data.totalAMD is number
                    && request.resource.data.items is list;
    }

    // Contact Messages Collections (public message creation with validation, admin full access)
    match /contactMessages/{messageId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.phone is string 
                    && request.resource.data.message is string;
    }
    match /onlyluxe_messages/{messageId} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.phone is string 
                    && request.resource.data.message is string;
    }
  }
}
